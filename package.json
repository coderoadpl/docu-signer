{
  "name": "podpisy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-first, strictly layered full-stack TypeScript foundation for multi-tenant SaaS",
  "imports": {
    "#core/*": "./core/*",
    "#adapters/*": "./adapters/*"
  },
  "scripts": {
    "dev:server": "tsx watch apps/server/src/entry.node.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "pnpm run build:web && pnpm run typecheck",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "vercel-build": "pnpm run db:migrate && pnpm run db:seed:deploy && pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "VITEST_INTEGRATION=1 vitest run --project integration --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "depcruise": "depcruise core adapters apps scripts api",
    "knip": "knip",
    "doc-lint": "tsx scripts/doc-lint.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lock-lint && pnpm run depcruise && pnpm run knip && pnpm run doc-lint && pnpm run test:coverage",
    "db:up": "tsx scripts/db-up-preflight.ts && docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx adapters/db/migrate.ts",
    "db:seed": "tsx adapters/db/seed.ts",
    "db:seed:deploy": "tsx adapters/db/seed-deploy.ts",
    "cli": "tsx apps/cli/src/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "e2e": "playwright test",
    "visual": "playwright test --config playwright.visual.config.ts",
    "visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "visual:report": "tsx scripts/visual-report.ts",
    "visual:verdict-input": "tsx scripts/visual-verdict-input.ts",
    "smoke:remote": "tsx scripts/smoke-remote.ts",
    "lock-lint": "pnpm install --frozen-lockfile --lockfile-only"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "brace-expansion@1": "1.1.16",
      "brace-expansion@5": "5.0.8",
      "fast-uri@3": "3.1.4",
      "handlebars@4": "4.7.9",
      "postcss@8": "8.5.22"
    }
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1095.0",
    "@better-auth/passkey": "^1.6.23",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/node-server": "^1.17.1",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "9.10.1",
    "@neondatabase/serverless": "^1.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "@tanstack/query-core": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^2.6.1",
    "better-auth": "^1.6.23",
    "commander": "^14.0.0",
    "dayjs": "1.11.21",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.12.32",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "perfect-freehand": "1.2.3",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@opentelemetry/core": "^2.10.0",
    "@playwright/test": "^1.62.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.14",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.3",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "msw": "^2.15.0",
    "otplib": "^13.4.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.62.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
